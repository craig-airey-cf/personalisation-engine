<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\vendor\gaming-event-streaming\src\GamingEventStreaming.Contracts\Protos\events.proto"
              GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\vendor\gaming-event-streaming\src\GamingEventStreaming.Contracts\Domain\EventStatus.cs"
             Link="Contracts\Domain\EventStatus.cs" />
    <Compile Include="..\..\vendor\gaming-event-streaming\src\GamingEventStreaming.Contracts\Domain\GamingEvent.cs"
             Link="Contracts\Domain\GamingEvent.cs" />
    <Compile Include="..\..\vendor\gaming-event-streaming\src\GamingEventStreaming.Contracts\Domain\GamingEventType.cs"
             Link="Contracts\Domain\GamingEventType.cs" />
    <Compile Include="..\..\vendor\gaming-event-streaming\src\GamingEventStreaming.Contracts\Validation\MessageValidator.cs"
             Link="Contracts\Validation\MessageValidator.cs" />
    <Compile Include="..\..\vendor\gaming-event-streaming\src\GamingEventStreaming.Contracts\Validation\SupportedCurrencies.cs"
             Link="Contracts\Validation\SupportedCurrencies.cs" />
  </ItemGroup>

</Project>
